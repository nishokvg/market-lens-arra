# Copy these values into Streamlit Community Cloud's Advanced settings -> Secrets.
# Never commit a file named .streamlit/secrets.toml.
APP_ACCESS_CODE = "choose-a-long-private-code"
DEMO_MODE = "false"
MAX_RESEARCH_WORKERS = "3"

TAVILY_API_KEY = ""
MEM0_API_KEY = ""
# Optional for a single-user private workspace. Omit to use an isolated browser-session ID.
MEM0_USER_ID = ""
PINECONE_API_KEY = ""
PINECONE_INDEX_NAME = "market-lens-sources"

# Native OpenAI users can leave OPENAI_BASE_URL blank and use native model names.
# OpenRouter users should use the values shown below.
OPENAI_API_KEY = ""
OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
OPENAI_MODEL = "openai/gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL = "openai/text-embedding-3-small"
USE_LLM_EXTRACTION = "true"
