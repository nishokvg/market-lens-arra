# Required for LLM-assisted fact extraction and embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave blank for native OpenAI. For OpenRouter use https://openrouter.ai/api/v1,
# an OpenRouter model name such as openai/gpt-4.1-mini, and
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small.
OPENAI_BASE_URL=
USE_LLM_EXTRACTION=false

# Optional: protects a live deployment that uses paid provider credits.
APP_ACCESS_CODE=
# Limits concurrent Tavily calls. Keep this low to control rate limits and cost.
MAX_RESEARCH_WORKERS=3

# Optional: enables fresh web research through Tavily.
TAVILY_API_KEY=

# Optional: enables long-term user preferences and previous-run context.
MEM0_API_KEY=
MEM0_DIR=.mem0
# Optional: a private, fixed workspace identifier for a single-user deployment.
MEM0_USER_ID=

# Optional: enables persistent source-snippet retrieval.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=market-lens-sources

# Set true only for a safe, repeatable classroom demonstration using labelled sample data.
DEMO_MODE=true
